      "expected": "profile entry 37 (STREAM_CORE_FINALITY_ADAPTER) is missing"
    },
    {
      "name": "duplicate-profile-instance",
      "target": "candidate",
      "operations": [
        {"op": "set", "path": "/instances/36/profile_entry_id", "value": 36}
      ],
      "expected": "duplicate profile entry id 36"
    },
    {
      "name": "extra-profile-instance",
      "target": "candidate",
      "operations": [
        {"op": "set", "path": "/instances/36/profile_entry_id", "value": 38}
      ],
      "expected_error": "greater than the maximum of 37"
    },
    {
      "name": "profile-key-drift",
      "target": "candidate",
      "operations": [
        {"op": "set", "path": "/instances/0/profile_entry_key", "value": "GOVERNANCE_LAYER"}
      ],
      "expected": "profile entry 1 (STREAM_CORE) profile_entry_key mismatch"
    },
    {
