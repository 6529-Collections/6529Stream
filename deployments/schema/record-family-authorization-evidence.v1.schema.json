{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/6529-Collections/6529Stream/main/deployments/schema/record-family-authorization-evidence.v1.schema.json",
  "title": "6529Stream Record-Family Authorization Evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "review_status",
    "evidence_id",
    "target_phase",
    "inventory_binding",
    "candidate_binding",
    "profile_binding",
    "classifier_binding",
    "implementation_bindings",
    "grant_map",
    "snapshot_intersection",
    "authority_lifecycle",
    "phases",
    "review",
    "redaction_policy",
    "template_notice"
  ],
  "properties": {
    "schema_version": {
      "const": "6529stream.record-family-authorization-evidence.v1"
    },
    "record_type": {
      "enum": ["template", "retained_evidence"]
    },
    "review_status": {
      "enum": ["unreviewed", "reviewed"]
    },
    "evidence_id": {
      "type": "string",
      "minLength": 1
    },
    "target_phase": {
      "oneOf": [
        {"type": "null"},
        {"enum": ["public_beta", "production_release"]}
      ]
    },
    "inventory_binding": {
      "$ref": "#/$defs/inventoryBinding"
    },
    "candidate_binding": {
      "$ref": "#/$defs/candidateBinding"
    },
    "profile_binding": {
      "$ref": "#/$defs/profileBinding"
    },
    "classifier_binding": {
      "$ref": "#/$defs/classifierBinding"
    },
    "implementation_bindings": {
      "$ref": "#/$defs/implementationBindings"
    },
    "grant_map": {
      "$ref": "#/$defs/grantMap"
    },
    "snapshot_intersection": {
      "$ref": "#/$defs/snapshotIntersection"
    },
    "authority_lifecycle": {
      "$ref": "#/$defs/authorityLifecycle"
    },
    "phases": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "allOf": [
            {"$ref": "#/$defs/phase"},
            {"properties": {"phase": {"const": "public_beta"}}}
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/phase"},
            {"properties": {"phase": {"const": "production_release"}}}
          ]
        }
      ],
      "items": false
    },
    "review": {
      "$ref": "#/$defs/review"
    },
    "redaction_policy": {
      "$ref": "#/$defs/redactionPolicy"
    },
    "template_notice": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"record_type": {"const": "template"}},
        "required": ["record_type"]
      },
      "then": {
        "properties": {
          "target_phase": {"type": "null"},
          "review_status": {"const": "unreviewed"},
          "inventory_binding": {
            "properties": {"status": {"const": "planning_bound"}}
          },
          "candidate_binding": {
            "properties": {
              "status": {"const": "not_available"},
              "candidate_identity_path": {"type": "null"}
            }
          },
          "profile_binding": {
            "properties": {"status": {"const": "missing"}}
          },
          "classifier_binding": {
            "properties": {"status": {"const": "missing"}}
          },
          "implementation_bindings": {
            "properties": {
              "status": {"const": "missing"},
              "review_status": {"const": "unreviewed"},
              "contracts": {"maxItems": 0}
            }
          },
          "grant_map": {
            "properties": {
              "status": {"const": "missing"},
              "review_status": {"const": "unreviewed"}
            }
          },
          "snapshot_intersection": {
            "properties": {
              "status": {"const": "missing"},
              "review_status": {"const": "unreviewed"},
              "covered_family_groups": {"maxItems": 0},
              "evidence_path": {"type": "null"}
            }
          },
          "authority_lifecycle": {
            "properties": {
              "status": {"const": "missing"},
              "review_status": {"const": "unreviewed"},
              "evidence_path": {"type": "null"}
            }
          },
          "phases": {
            "prefixItems": [
              {
                "properties": {
                  "status": {"const": "missing"},
                  "review_status": {"const": "unreviewed"},
                  "evidence_path": {"type": "null"},
                  "evidence_sha256": {"type": "null"}
                }
              },
              {
                "properties": {
                  "status": {"const": "missing"},
                  "review_status": {"const": "unreviewed"},
                  "evidence_path": {"type": "null"},
                  "evidence_sha256": {"type": "null"}
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {"record_type": {"const": "retained_evidence"}},
        "required": ["record_type"]
      },
      "then": {
        "properties": {
          "target_phase": {
            "enum": ["public_beta", "production_release"]
          },
          "review_status": {"const": "reviewed"},
          "inventory_binding": {
            "properties": {
              "status": {"const": "complete"},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          },
          "candidate_binding": {
            "properties": {
              "status": {"const": "complete"},
              "candidate_id": {"type": "string", "minLength": 1},
              "candidate_identity_sha256": {"$ref": "#/$defs/nonzeroSha256"},
              "candidate_identity_keccak256": {"$ref": "#/$defs/nonzeroKeccak"},
              "candidate_identity_path": {"$ref": "#/$defs/repoPath"},
              "source_commit": {"$ref": "#/$defs/nonzeroCommit"},
              "release_build": {"type": "string", "minLength": 1},
              "genesis_profile_sha256": {"$ref": "#/$defs/nonzeroSha256"}
            }
          },
          "profile_binding": {
            "properties": {
              "status": {"const": "complete"},
              "sha256": {"$ref": "#/$defs/nonzeroSha256"}
            }
          },
          "classifier_binding": {
            "properties": {
              "status": {"const": "complete"},
              "host_address": {"$ref": "#/$defs/nonzeroAddress"},
              "contract_address": {"$ref": "#/$defs/nonzeroAddress"},
              "module_type": {"$ref": "#/$defs/nonzeroKeccak"},
              "interface_id": {"$ref": "#/$defs/validInterfaceId"},
              "marker": {"$ref": "#/$defs/validInterfaceId"},
              "schema": {"$ref": "#/$defs/nonzeroKeccak"},
              "revision": {"type": "integer", "minimum": 1},
              "configuration_revision": {"type": "integer", "minimum": 1},
              "configuration_hash": {"$ref": "#/$defs/nonzeroKeccak"},
              "configuration_authority": {"$ref": "#/$defs/nonzeroAddress"},
              "pending_configuration_authority": {"$ref": "#/$defs/address"},
              "record_type_count": {"type": "integer", "minimum": 1},
              "observed_chain_id": {"type": "integer", "minimum": 1},
              "observed_block_number": {"type": "integer", "minimum": 1},
              "observed_block_hash": {"$ref": "#/$defs/nonzeroKeccak"},
              "observed_block_finalized": {"const": true},
              "runtime_codehash": {"$ref": "#/$defs/nonzeroKeccak"},
              "grant_map_sha256": {"$ref": "#/$defs/nonzeroSha256"}
            }
          },
          "implementation_bindings": {
            "properties": {
              "status": {"const": "complete"},
              "review_status": {"const": "reviewed"},
              "contracts": {"minItems": 2, "maxItems": 2}
            }
          },
          "grant_map": {
            "properties": {
              "status": {"const": "complete"},
              "review_status": {"const": "reviewed"},
              "path": {"$ref": "#/$defs/repoPath"},
              "sha256": {"$ref": "#/$defs/nonzeroSha256"},
              "family_group_count": {"const": 14},
              "authorization_class_count": {"const": 8},
              "candidate_identity_sha256": {"$ref": "#/$defs/nonzeroSha256"}
            }
          },
          "snapshot_intersection": {
            "properties": {
              "status": {"const": "complete"},
              "review_status": {"const": "reviewed"},
              "covered_family_groups": {
                "prefixItems": [
                  {"const": "ARTIST"},
                  {"const": "OWNER"},
                  {"const": "INDEPENDENT"},
                  {"const": "CURATOR"},
                  {"const": "INSTITUTION"},
                  {"const": "RIGHTS"},
                  {"const": "ARCHIVE"},
                  {"const": "FIXITY"},
                  {"const": "C2PA"},
                  {"const": "IIIF"},
                  {"const": "MEDIA_RELATIONSHIP"},
                  {"const": "IDENTITY_DISPLAY"},
                  {"const": "SNAPSHOT"},
                  {"const": "AGENT"}
                ],
                "items": false,
                "minItems": 14,
                "maxItems": 14
              },
              "evidence_path": {"$ref": "#/$defs/repoPath"},
              "evidence_sha256": {"$ref": "#/$defs/nonzeroSha256"}
            }
          },
          "authority_lifecycle": {
            "properties": {
              "status": {"const": "complete"},
              "review_status": {"const": "reviewed"},
              "rotation_revision": {"type": "integer", "minimum": 1},
              "revocation_revision": {"type": "integer", "minimum": 1},
              "proposal_old_authority": {"$ref": "#/$defs/nonzeroAddress"},
              "proposed_authority": {"$ref": "#/$defs/nonzeroAddress"},
              "proposal_configuration_revision": {"type": "integer", "minimum": 1},
              "proposal_configuration_hash": {"$ref": "#/$defs/nonzeroKeccak"},
              "acceptance_old_authority": {"$ref": "#/$defs/nonzeroAddress"},
              "accepted_authority": {"$ref": "#/$defs/nonzeroAddress"},
              "acceptance_configuration_revision": {"type": "integer", "minimum": 1},
              "acceptance_configuration_hash": {"$ref": "#/$defs/nonzeroKeccak"},
              "cancellation_authority": {"$ref": "#/$defs/nonzeroAddress"},
              "cancelled_pending_authority": {"$ref": "#/$defs/nonzeroAddress"},
              "cancellation_configuration_revision": {"type": "integer", "minimum": 1},
              "cancellation_configuration_hash": {"$ref": "#/$defs/nonzeroKeccak"},
              "record_family_registry": {"$ref": "#/$defs/nonzeroAddress"},
              "observed_chain_id": {"type": "integer", "minimum": 1},
              "observed_block_number": {"type": "integer", "minimum": 1},
              "observed_block_hash": {"$ref": "#/$defs/nonzeroKeccak"},
              "observed_block_finalized": {"const": true},
              "observed_configuration_authority": {"$ref": "#/$defs/nonzeroAddress"},
              "observed_pending_configuration_authority": {"$ref": "#/$defs/address"},
              "observed_configuration_revision": {"type": "integer", "minimum": 1},
              "observed_configuration_hash": {"$ref": "#/$defs/nonzeroKeccak"},
              "commitment_linkage_status": {"const": "reviewed"},
              "commitment_linkage_reference": {"type": "string", "pattern": ".*\\S.*"},
              "observed_at_commit": {"$ref": "#/$defs/nonzeroCommit"},
              "evidence_path": {"$ref": "#/$defs/repoPath"},
              "evidence_sha256": {"$ref": "#/$defs/nonzeroSha256"}
            }
          },
          "review": {
            "properties": {
              "reviewer": {"type": "string", "pattern": ".*\\S.*"},
              "reviewed_at": {"type": "string", "format": "date-time"},
              "reference": {"type": "string", "pattern": ".*\\S.*"}
            }
          },
          "redaction_policy": {
            "properties": {
              "redacted_fields": {
                "const": [
                  "private_key",
                  "mnemonic",
                  "seed_phrase",
                  "api_key",
                  "rpc_url"
                ]
              }
            }
          },
          "template_notice": {
            "const": "Retained evidence does not by itself satisfy public-beta or production release mode; family-scoped implementation enforcement and the hard release stop must be independently cleared."
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_type": {"const": "retained_evidence"},
          "target_phase": {"const": "public_beta"}
        },
        "required": ["record_type", "target_phase"]
      },
      "then": {
        "properties": {
          "evidence_id": {
            "const": "record-family-authorization-public-beta-v1"
          },
          "phases": {
            "prefixItems": [
              {
                "properties": {
                  "status": {"const": "complete"},
                  "review_status": {"const": "reviewed"},
                  "evidence_path": {"$ref": "#/$defs/repoPath"},
                  "evidence_sha256": {"$ref": "#/$defs/nonzeroSha256"}
                }
              },
              {
                "properties": {
                  "status": {"const": "missing"},
                  "review_status": {"const": "unreviewed"},
                  "evidence_path": {"type": "null"},
                  "evidence_sha256": {"type": "null"}
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_type": {"const": "retained_evidence"},
          "target_phase": {"const": "production_release"}
        },
        "required": ["record_type", "target_phase"]
      },
      "then": {
        "properties": {
          "evidence_id": {
            "const": "record-family-authorization-production-release-v1"
          },
          "phases": {
            "prefixItems": [
              {
                "properties": {
                  "status": {"const": "complete"},
                  "review_status": {"const": "reviewed"},
                  "evidence_path": {"$ref": "#/$defs/repoPath"},
                  "evidence_sha256": {"$ref": "#/$defs/nonzeroSha256"}
                }
              },
              {
                "properties": {
                  "status": {"const": "complete"},
                  "review_status": {"const": "reviewed"},
                  "evidence_path": {"$ref": "#/$defs/repoPath"},
                  "evidence_sha256": {"$ref": "#/$defs/nonzeroSha256"}
                }
              }
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "inventoryBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "path", "schema_version", "sha256"],
      "properties": {
        "status": {
          "enum": ["planning_bound", "complete"]
        },
        "path": {
          "const": "release-artifacts/record-family-authorization-inventory.json"
        },
        "schema_version": {
          "const": "6529stream.record-family-authorization-inventory.v1"
        },
        "sha256": {
          "$ref": "#/$defs/nullableSha256"
        }
      }
    },
    "candidateBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "candidate_id",
        "candidate_identity_sha256",
        "candidate_identity_keccak256",
        "candidate_identity_path",
        "source_commit",
        "release_build",
        "genesis_profile_sha256"
      ],
      "properties": {
        "status": {
          "enum": ["not_available", "complete"]
        },
        "candidate_id": {
          "$ref": "#/$defs/nullableString"
        },
        "candidate_identity_sha256": {
          "$ref": "#/$defs/nullableSha256"
        },
        "candidate_identity_keccak256": {
          "$ref": "#/$defs/nullableKeccak"
        },
        "candidate_identity_path": {
          "$ref": "#/$defs/nullableRepoPath"
        },
        "source_commit": {
          "$ref": "#/$defs/nullableCommit"
        },
        "release_build": {
          "$ref": "#/$defs/nullableString"
        },
        "genesis_profile_sha256": {
          "$ref": "#/$defs/nullableSha256"
        }
      }
    },
    "profileBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "path", "schema_version", "sha256"],
      "properties": {
        "status": {
          "enum": ["missing", "complete"]
        },
        "path": {
          "const": "release-artifacts/genesis-deployment-profile.json"
        },
        "schema_version": {
          "const": "6529stream.genesis-deployment-profile.v2"
        },
        "sha256": {
          "$ref": "#/$defs/nullableSha256"
        }
      }
    },
    "classifierBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "host_address",
        "contract_address",
        "module_type",
        "interface_id",
        "marker",
        "schema",
        "revision",
        "configuration_revision",
        "configuration_hash",
        "configuration_authority",
        "pending_configuration_authority",
        "pending_configuration_authority_disposition",
        "record_type_count",
        "observed_chain_id",
        "observed_block_number",
        "observed_block_hash",
        "observed_block_finalized",
        "runtime_codehash",
        "grant_map_sha256"
      ],
      "properties": {
        "status": {
          "enum": ["missing", "complete"]
        },
        "host_address": {
          "$ref": "#/$defs/nullableAddress"
        },
        "contract_address": {
          "$ref": "#/$defs/nullableAddress"
        },
        "module_type": {
          "$ref": "#/$defs/nullableKeccak"
        },
        "interface_id": {
          "$ref": "#/$defs/nullableInterfaceId"
        },
        "marker": {
          "$ref": "#/$defs/nullableInterfaceId"
        },
        "schema": {
          "$ref": "#/$defs/nullableKeccak"
        },
        "revision": {
          "$ref": "#/$defs/nullablePositiveInteger"
        },
        "configuration_revision": {
          "$ref": "#/$defs/nullablePositiveInteger"
        },
        "configuration_hash": {
          "$ref": "#/$defs/nullableKeccak"
        },
        "configuration_authority": {
          "$ref": "#/$defs/nullableAddress"
        },
        "pending_configuration_authority": {
          "$ref": "#/$defs/nullableAddress"
        },
        "pending_configuration_authority_disposition": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/pendingAuthorityDisposition"}
          ]
        },
        "record_type_count": {
          "$ref": "#/$defs/nullablePositiveInteger"
        },
        "observed_chain_id": {
          "$ref": "#/$defs/nullablePositiveInteger"
        },
        "observed_block_number": {
          "$ref": "#/$defs/nullablePositiveInteger"
        },
        "observed_block_hash": {
          "$ref": "#/$defs/nullableKeccak"
        },
        "observed_block_finalized": {
          "oneOf": [
            {"type": "null"},
            {"type": "boolean"}
          ]
        },
        "runtime_codehash": {
          "$ref": "#/$defs/nullableKeccak"
        },
        "grant_map_sha256": {
          "$ref": "#/$defs/nullableSha256"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "pending_configuration_authority": {
                "const": "0x0000000000000000000000000000000000000000"
              }
            },
            "required": ["pending_configuration_authority"]
          },
          "then": {
            "properties": {
              "pending_configuration_authority_disposition": {"type": "null"}
            }
          }
        },
        {
          "if": {
            "properties": {
              "pending_configuration_authority": {
                "type": "string",
                "pattern": "^0x(?!0{40}$)[0-9a-f]{40}$"
              }
            },
            "required": ["pending_configuration_authority"]
          },
          "then": {
            "properties": {
              "pending_configuration_authority_disposition": {
                "$ref": "#/$defs/pendingAuthorityDisposition"
              }
            }
          }
        }
      ]
    },
    "implementationBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "source_path",
        "source_sha256",
        "interface_path",
        "interface_sha256",
        "address",
        "record_family_registry",
        "configuration_authority",
        "pending_configuration_authority",
        "configuration_revision",
        "configuration_hash",
        "record_type_count",
        "observed_chain_id",
        "observed_block_number",
        "observed_block_hash",
        "observed_block_finalized",
        "runtime_sha256",
        "runtime_keccak256",
        "interface_ids",
        "marker",
        "revision",
        "evidence_path",
        "evidence_sha256"
      ],
      "properties": {
        "contract": {
          "type": "string",
          "minLength": 1
        },
        "source_path": {
          "$ref": "#/$defs/repoPath"
        },
        "source_sha256": {
          "$ref": "#/$defs/nonzeroSha256"
        },
        "interface_path": {
          "$ref": "#/$defs/repoPath"
        },
        "interface_sha256": {
          "$ref": "#/$defs/nonzeroSha256"
        },
        "address": {
          "$ref": "#/$defs/nonzeroAddress"
        },
        "record_family_registry": {
          "$ref": "#/$defs/nonzeroAddress"
        },
        "configuration_authority": {
          "$ref": "#/$defs/nonzeroAddress"
        },
        "pending_configuration_authority": {
          "$ref": "#/$defs/address"
        },
        "configuration_revision": {
          "type": "integer",
          "minimum": 1
        },
        "configuration_hash": {
          "$ref": "#/$defs/nonzeroKeccak"
        },
        "record_type_count": {
          "type": "integer",
          "minimum": 1
        },
        "observed_chain_id": {
          "type": "integer",
          "minimum": 1
        },
        "observed_block_number": {
          "type": "integer",
          "minimum": 1
        },
        "observed_block_hash": {
          "$ref": "#/$defs/nonzeroKeccak"
        },
        "observed_block_finalized": {
          "const": true
        },
        "runtime_sha256": {
          "$ref": "#/$defs/nonzeroSha256"
        },
        "runtime_keccak256": {
          "$ref": "#/$defs/nonzeroKeccak"
        },
        "interface_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/validInterfaceId"
          }
        },
        "marker": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "evidence_path": {
          "$ref": "#/$defs/repoPath"
        },
        "evidence_sha256": {
          "$ref": "#/$defs/nonzeroSha256"
        }
      }
    },
    "implementationBindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "review_status", "contracts"],
      "properties": {
        "status": {
          "enum": ["missing", "complete"]
        },
        "review_status": {
          "enum": ["unreviewed", "reviewed"]
        },
        "contracts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/implementationBinding"
          }
        }
      }
    },
    "grantMap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "review_status",
        "path",
        "schema_path",
        "schema_version",
        "sha256",
        "family_group_count",
        "authorization_class_count",
        "candidate_identity_sha256"
      ],
      "properties": {
        "status": {
          "enum": ["missing", "complete"]
        },
        "review_status": {
          "enum": ["unreviewed", "reviewed"]
        },
        "path": {
          "$ref": "#/$defs/nullableRepoPath"
        },
        "schema_path": {
          "const": "deployments/schema/record-family-authorization-grant-map.v1.schema.json"
        },
        "schema_version": {
          "const": "6529stream.record-family-authorization-grant-map.v1"
        },
        "sha256": {
          "$ref": "#/$defs/nullableSha256"
        },
        "family_group_count": {
          "$ref": "#/$defs/nullablePositiveInteger"
        },
        "authorization_class_count": {
          "$ref": "#/$defs/nullablePositiveInteger"
        },
        "candidate_identity_sha256": {
          "$ref": "#/$defs/nullableSha256"
        }
      }
    },
    "snapshotIntersection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "review_status",
        "covered_family_groups",
        "evidence_path",
        "evidence_sha256"
      ],
      "properties": {
        "status": {
          "enum": ["missing", "complete"]
        },
        "review_status": {
          "enum": ["unreviewed", "reviewed"]
        },
        "covered_family_groups": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          }
        },
        "evidence_path": {
          "$ref": "#/$defs/nullableRepoPath"
        },
        "evidence_sha256": {
          "$ref": "#/$defs/nullableSha256"
        }
      }
    },
    "authorityLifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "review_status",
        "rotation_revision",
        "revocation_revision",
        "proposal_old_authority",
        "proposed_authority",
        "proposal_configuration_revision",
        "proposal_configuration_hash",
        "acceptance_old_authority",
        "accepted_authority",
        "acceptance_configuration_revision",
        "acceptance_configuration_hash",
        "cancellation_authority",
        "cancelled_pending_authority",
        "cancellation_configuration_revision",
        "cancellation_configuration_hash",
        "record_family_registry",
        "observed_chain_id",
        "observed_block_number",
        "observed_block_hash",
        "observed_block_finalized",
        "observed_configuration_authority",
        "observed_pending_configuration_authority",
        "observed_configuration_revision",
        "observed_configuration_hash",
        "commitment_linkage_status",
        "commitment_linkage_reference",
        "observed_at_commit",
        "evidence_path",
        "evidence_sha256"
      ],
      "properties": {
        "status": {
          "enum": ["missing", "complete"]
        },
        "review_status": {
          "enum": ["unreviewed", "reviewed"]
        },
        "rotation_revision": {
          "$ref": "#/$defs/nullablePositiveInteger"
        },
        "revocation_revision": {
          "$ref": "#/$defs/nullablePositiveInteger"
        },
        "proposal_old_authority": {
          "$ref": "#/$defs/nullableAddress"
        },
        "proposed_authority": {
          "$ref": "#/$defs/nullableAddress"
        },
        "proposal_configuration_revision": {
          "$ref": "#/$defs/nullablePositiveInteger"
        },
        "proposal_configuration_hash": {
          "$ref": "#/$defs/nullableKeccak"
        },
        "acceptance_old_authority": {
          "$ref": "#/$defs/nullableAddress"
        },
        "accepted_authority": {
          "$ref": "#/$defs/nullableAddress"
        },
        "acceptance_configuration_revision": {
          "$ref": "#/$defs/nullablePositiveInteger"
        },
        "acceptance_configuration_hash": {
          "$ref": "#/$defs/nullableKeccak"
        },
        "cancellation_authority": {
          "$ref": "#/$defs/nullableAddress"
        },
        "cancelled_pending_authority": {
          "$ref": "#/$defs/nullableAddress"
        },
        "cancellation_configuration_revision": {
          "$ref": "#/$defs/nullablePositiveInteger"
        },
        "cancellation_configuration_hash": {
          "$ref": "#/$defs/nullableKeccak"
        },
        "record_family_registry": {
          "$ref": "#/$defs/nullableAddress"
        },
        "observed_chain_id": {
          "$ref": "#/$defs/nullablePositiveInteger"
        },
        "observed_block_number": {
          "$ref": "#/$defs/nullablePositiveInteger"
        },
        "observed_block_hash": {
          "$ref": "#/$defs/nullableKeccak"
        },
        "observed_block_finalized": {
          "oneOf": [
            {"type": "null"},
            {"type": "boolean"}
          ]
        },
        "observed_configuration_authority": {
          "$ref": "#/$defs/nullableAddress"
        },
        "observed_pending_configuration_authority": {
          "$ref": "#/$defs/nullableAddress"
        },
        "observed_configuration_revision": {
          "$ref": "#/$defs/nullablePositiveInteger"
        },
        "observed_configuration_hash": {
          "$ref": "#/$defs/nullableKeccak"
        },
        "commitment_linkage_status": {
          "oneOf": [
            {"type": "null"},
            {"const": "reviewed"}
          ]
        },
        "commitment_linkage_reference": {
          "$ref": "#/$defs/nullableString"
        },
        "observed_at_commit": {
          "$ref": "#/$defs/nullableCommit"
        },
        "evidence_path": {
          "$ref": "#/$defs/nullableRepoPath"
        },
        "evidence_sha256": {
          "$ref": "#/$defs/nullableSha256"
        }
      }
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "status",
        "review_status",
        "evidence_path",
        "evidence_sha256"
      ],
      "properties": {
        "phase": {
          "enum": ["public_beta", "production_release"]
        },
        "status": {
          "enum": ["missing", "complete"]
        },
        "review_status": {
          "enum": ["unreviewed", "reviewed"]
        },
        "evidence_path": {
          "$ref": "#/$defs/nullableRepoPath"
        },
        "evidence_sha256": {
          "$ref": "#/$defs/nullableSha256"
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer", "reviewed_at", "reference"],
      "properties": {
        "reviewer": {
          "$ref": "#/$defs/nullableString"
        },
        "reviewed_at": {
          "$ref": "#/$defs/nullableTimestamp"
        },
        "reference": {
          "$ref": "#/$defs/nullableString"
        }
      }
    },
    "redactionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["no_secrets", "redacted_fields"],
      "properties": {
        "no_secrets": {
          "const": true
        },
        "redacted_fields": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)[^\\u0000-\\u001f\\u007f<>:\"|?*]+$"
    },
    "pendingAuthorityDisposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reviewer", "reviewed_at", "reference", "rationale"],
      "properties": {
        "status": {"const": "reviewed"},
        "reviewer": {"type": "string", "pattern": ".*\\S.*"},
        "reviewed_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?Z$"
        },
        "reference": {"type": "string", "pattern": ".*\\S.*"},
        "rationale": {"type": "string", "pattern": ".*\\S.*"}
      }
    },
    "address": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{40}$"
    },
    "nullableRepoPath": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/repoPath"}
      ]
    },
    "nullableString": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "minLength": 1}
      ]
    },
    "nullableSha256": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      ]
    },
    "nullableKeccak": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^0x[0-9a-f]{64}$"}
      ]
    },
    "nullableCommit": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      ]
    },
    "nullableAddress": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^0x[0-9a-f]{40}$"}
      ]
    },
    "nullableInterfaceId": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^0x[0-9a-f]{8}$"}
      ]
    },
    "nullablePositiveInteger": {
      "oneOf": [
        {"type": "null"},
        {"type": "integer", "minimum": 1}
      ]
    },
    "nonzeroSha256": {
      "type": "string",
      "pattern": "^(?!0{64}$)[0-9a-f]{64}$"
    },
    "nonzeroKeccak": {
      "type": "string",
      "pattern": "^0x(?!0{64}$)[0-9a-f]{64}$"
    },
    "nonzeroCommit": {
      "type": "string",
      "pattern": "^(?!0{40}$)[0-9a-f]{40}$"
    },
    "nonzeroAddress": {
      "type": "string",
      "pattern": "^0x(?!0{40}$)[0-9a-f]{40}$"
    },
    "validInterfaceId": {
      "type": "string",
      "pattern": "^0x(?!00000000$)(?!ffffffff$)[0-9a-f]{8}$"
    },
    "nullableTimestamp": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?Z$"
        }
      ]
    }
  }
}
