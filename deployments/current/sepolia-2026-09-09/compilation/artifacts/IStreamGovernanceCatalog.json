      "devdoc": {
        "details": "The genesis catalog is revision zero. Existing entries cannot be edited      or removed. An extension invalidates actions scheduled under older roots.",
        "kind": "dev",
        "methods": {
          "extendGovernanceActionPolicy(uint64,bytes32,bytes32,(uint8,address,bytes4,bytes32,bytes32,uint8,uint8,uint256,bytes32)[])": {
            "details": "Entries sort by keccak256(abi.encode(actionClass,target,selector)).      Requires a sealed Executor and an ordinary root-proposed class-3      batch consisting exactly of this call then manifest publication."
          }
        },
        "version": 1
      },
      "userdoc": {
        "kind": "user",
        "methods": {
          "extendGovernanceActionPolicy(uint64,bytes32,bytes32,(uint8,address,bytes4,bytes32,bytes32,uint8,uint8,uint256,bytes32)[])": {
            "notice": "Append 1–64 entries, with a total catalog limit of 1,024."
          }
        },
        "notice": "Delayed, append-only extensions of the exact-target governance catalog.",
        "version": 1
