<span id="cb27-19"><a href="#cb27-19" aria-hidden="true" tabindex="-1"></a>        &lt;/<span class="kw">skos:Concept</span>&gt;</span>
<span id="cb27-20"><a href="#cb27-20" aria-hidden="true" tabindex="-1"></a>        &lt;<span class="kw">lido:term</span></span>
<span id="cb27-21"><a href="#cb27-21" aria-hidden="true" tabindex="-1"></a><span class="ot">            lido:addedSearchTerm=</span><span class="st">&quot;yes&quot;</span></span>
<span id="cb27-22"><a href="#cb27-22" aria-hidden="true" tabindex="-1"></a><span class="ot">            xml:lang=</span><span class="st">&quot;fr&quot;</span>&gt;</span>
<span id="cb27-23"><a href="#cb27-23" aria-hidden="true" tabindex="-1"></a>            peinture</span>
<span id="cb27-24"><a href="#cb27-24" aria-hidden="true" tabindex="-1"></a>        &lt;/<span class="kw">lido:term</span>&gt;</span>
<span id="cb27-25"><a href="#cb27-25" aria-hidden="true" tabindex="-1"></a>        <span class="co">&lt;!-- Display label --&gt;</span></span>
<span id="cb27-26"><a href="#cb27-26" aria-hidden="true" tabindex="-1"></a>        &lt;<span class="kw">lido:term</span></span>
<span id="cb27-27"><a href="#cb27-27" aria-hidden="true" tabindex="-1"></a><span class="ot">            lido:pref=</span><span class="st">&quot;http://terminology.lido-schema.org/lido00526&quot;</span></span>
<span id="cb27-28"><a href="#cb27-28" aria-hidden="true" tabindex="-1"></a><span class="ot">            xml:lang=</span><span class="st">&quot;fr&quot;</span>&gt;</span>
