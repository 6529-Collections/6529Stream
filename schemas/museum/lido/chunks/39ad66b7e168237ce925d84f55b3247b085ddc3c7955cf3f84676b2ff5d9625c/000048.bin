<span id="cb47-17"><a href="#cb47-17" aria-hidden="true" tabindex="-1"></a>       &lt;/<span class="kw">skos:mappingRelation</span>&gt;</span>
<span id="cb47-18"><a href="#cb47-18" aria-hidden="true" tabindex="-1"></a>   &lt;/<span class="kw">skos:Concept</span>&gt;</span>
<span id="cb47-19"><a href="#cb47-19" aria-hidden="true" tabindex="-1"></a>   &lt;<span class="kw">lido:term</span></span>
