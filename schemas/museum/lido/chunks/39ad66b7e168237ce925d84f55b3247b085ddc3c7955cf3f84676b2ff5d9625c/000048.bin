<span id="cb47-9"><a href="#cb47-9" aria-hidden="true" tabindex="-1"></a><span class="ot">           xml:lang=</span><span class="st">&quot;en&quot;</span>&gt;</span>
<span id="cb47-10"><a href="#cb47-10" aria-hidden="true" tabindex="-1"></a>           smiled</span>
<span id="cb47-11"><a href="#cb47-11" aria-hidden="true" tabindex="-1"></a>       &lt;/<span class="kw">skos:altLabel</span>&gt;</span>
<span id="cb47-12"><a href="#cb47-12" aria-hidden="true" tabindex="-1"></a>       &lt;<span class="kw">skos:mappingRelation</span>&gt;</span>
<span id="cb47-13"><a href="#cb47-13" aria-hidden="true" tabindex="-1"></a>           http://www.wikidata.org/entity/Q487</span>
<span id="cb47-14"><a href="#cb47-14" aria-hidden="true" tabindex="-1"></a>       &lt;/<span class="kw">skos:mappingRelation</span>&gt;</span>
