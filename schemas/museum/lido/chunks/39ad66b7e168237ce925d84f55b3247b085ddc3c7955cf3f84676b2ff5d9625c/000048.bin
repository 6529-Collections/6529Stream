<span id="cb47-22"><a href="#cb47-22" aria-hidden="true" tabindex="-1"></a>       smile</span>
<span id="cb47-23"><a href="#cb47-23" aria-hidden="true" tabindex="-1"></a>   &lt;/<span class="kw">lido:term</span>&gt;</span>
<span id="cb47-24"><a href="#cb47-24" aria-hidden="true" tabindex="-1"></a>   &lt;<span class="kw">lido:term</span></span>
<span id="cb47-25"><a href="#cb47-25" aria-hidden="true" tabindex="-1"></a><span class="ot">       lido:addedSearchTerm=</span><span class="st">&quot;yes&quot;</span></span>
<span id="cb47-26"><a href="#cb47-26" aria-hidden="true" tabindex="-1"></a><span class="ot">       xml:lang=</span><span class="st">&quot;de&quot;</span>&gt;</span>
