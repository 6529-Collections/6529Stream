    <rdfs:label xml:lang="ru">являeтся дeйствующим или бывшим члeном</rdfs:label>
    <rdfs:label xml:lang="zh">是当前或以往成员</rdfs:label>
    <rdfs:domain rdf:resource="E39_Actor" />
    <rdfs:range rdf:resource="E74_Group" />
    <owl:inverseOf rdf:resource="P107_has_current_or_former_member" />
  </rdf:Property>
