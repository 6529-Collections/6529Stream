{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://6529.io/schemas/record-family-authorization-source-catalog.v1.schema.json",
  "title": "6529Stream Record-Family Authorization Source Catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "tracking_issue",
    "source_commit",
    "source_bindings",
    "classifier",
    "authorization_classes",
    "family_groups",
    "host_bindings",
    "snapshot_policy",
    "lock_policy",
    "capacity_policy",
    "configuration_policy",
    "independent_policy",
    "source_tests",
    "remaining_blockers"
  ],
  "properties": {
    "schema_version": {
      "const": "6529stream.record-family-authorization-source-catalog.v1"
    },
    "status": {
      "const": "source_implemented_candidate_unbound"
    },
    "tracking_issue": {
      "const": "https://github.com/6529-Collections/6529Stream/issues/690"
    },
    "source_commit": {
      "$ref": "#/$defs/commit"
    },
    "source_bindings": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/sourceBinding"
      }
    },
    "classifier": {
      "$ref": "#/$defs/classifier"
    },
    "authorization_classes": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/authorizationClass"
      }
    },
    "family_groups": {
      "type": "array",
      "minItems": 14,
      "maxItems": 14,
      "items": {
        "$ref": "#/$defs/familyGroup"
      }
    },
    "host_bindings": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/hostBinding"
      }
    },
    "snapshot_policy": {
      "$ref": "#/$defs/snapshotPolicy"
    },
    "lock_policy": {
      "$ref": "#/$defs/lockPolicy"
    },
    "capacity_policy": {
      "$ref": "#/$defs/capacityPolicy"
    },
    "configuration_policy": {
      "$ref": "#/$defs/configurationPolicy"
    },
    "independent_policy": {
      "$ref": "#/$defs/independentPolicy"
    },
    "source_tests": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/repoPath"
      }
    },
    "remaining_blockers": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "bytes32": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "selector": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{8}$"
    },
    "repoPath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.\\.?(?:/|$)).+$"
    },
    "sourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "$ref": "#/$defs/repoPath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "classifier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "source_path",
        "implementation_source_path",
        "interface_path",
        "authority_provider_interface_path",
        "interface_id",
        "marker_selector",
        "schema_version",
        "record_type_admission",
        "wildcard_admission",
        "configuration_authority",
        "pending_configuration_authority",
        "deployment_model",
        "candidate_binding_status"
      ],
      "properties": {
        "contract": {
          "const": "StreamCollectionMetadata"
        },
        "source_path": {
          "$ref": "#/$defs/repoPath"
        },
        "implementation_source_path": {
          "$ref": "#/$defs/repoPath"
        },
        "interface_path": {
          "$ref": "#/$defs/repoPath"
        },
        "authority_provider_interface_path": {
          "$ref": "#/$defs/repoPath"
        },
        "interface_id": {
          "$ref": "#/$defs/selector"
        },
        "marker_selector": {
          "$ref": "#/$defs/selector"
        },
        "schema_version": {
          "const": 1
        },
        "record_type_admission": {
          "const": "append_only_exact_bytes32"
        },
        "wildcard_admission": {
          "const": false
        },
        "configuration_authority": {
          "const": "stored_configurationAuthority_initialized_from_stream_admins_owner"
        },
        "pending_configuration_authority": {
          "const": "stored_pendingConfigurationAuthority_zero_without_proposal"
        },
        "deployment_model": {
          "const": "embedded_in_collection_metadata_host"
        },
        "candidate_binding_status": {
          "const": "not_available"
        }
      }
    },
    "authorizationClass": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "mode"],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "name": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "mode": {
          "enum": [
            "live_provider",
            "family_grant",
            "direct_self_attributed"
          ]
        }
      }
    },
    "familyGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "id_preimage",
        "id",
        "allowed_authorization_class_ids",
        "admin_authority_rejected"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "id_preimage": {
          "type": "string",
          "pattern": "^6529STREAM_RECORD_FAMILY_[A-Z0-9_]+_V1$"
        },
        "id": {
          "$ref": "#/$defs/bytes32"
        },
        "allowed_authorization_class_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8
          }
        },
        "admin_authority_rejected": {
          "type": "boolean"
        }
      }
    },
    "hostBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "source_path",
        "interface_path",
        "interface_id",
        "registry_binding",
        "authorization_class_persisted"
      ],
      "properties": {
        "contract": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "source_path": {
          "$ref": "#/$defs/repoPath"
        },
        "interface_path": {
          "$ref": "#/$defs/repoPath"
        },
        "interface_id": {
          "$ref": "#/$defs/selector"
        },
        "registry_binding": {
          "enum": [
            "embedded_self",
            "external_classifier_host"
          ]
        },
        "authorization_class_persisted": {
          "const": true
        }
      }
    },
    "snapshotPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "abi",
        "selector",
        "covered_record_types",
        "every_record_type_authority_revalidated",
        "covered_record_types_hash_stored",
        "per_record_type_authorization_event"
      ],
      "properties": {
        "abi": {
          "type": "string",
          "minLength": 1
        },
        "selector": {
          "$ref": "#/$defs/selector"
        },
        "covered_record_types": {
          "const": "strictly_ascending_nonempty_exact_ids"
        },
        "every_record_type_authority_revalidated": {
          "const": true
        },
        "covered_record_types_hash_stored": {
          "const": true
        },
        "per_record_type_authorization_event": {
          "const": true
        }
      }
    },
    "lockPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reserved_lock_authority",
        "declared_record_type_authority",
        "independent_family_lock_allowed",
        "authorization_class_persisted"
      ],
      "properties": {
        "reserved_lock_authority": {
          "const": "function_or_global_admin"
        },
        "declared_record_type_authority": {
          "const": "record_family"
        },
        "independent_family_lock_allowed": {
          "const": false
        },
        "authorization_class_persisted": {
          "const": true
        }
      }
    },
    "capacityPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximum_record_types_per_collection",
        "reserved_lock_slots",
        "undeclared_record_types_rejected_before_slot_consumption"
      ],
      "properties": {
        "maximum_record_types_per_collection": {
          "const": 128
        },
        "reserved_lock_slots": {
          "const": 2
        },
        "undeclared_record_types_rejected_before_slot_consumption": {
          "const": true
        }
      }
    },
    "configurationPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision_scope",
        "commitment",
        "record_type_count",
        "candidate_observation"
      ],
      "properties": {
        "revision_scope": {
          "const": "all_admission_provider_and_grant_mutations"
        },
        "commitment": {
          "const": "chain_and_registry_domain_separated_hash_chain"
        },
        "record_type_count": {
          "const": "global_append_only"
        },
        "candidate_observation": {
          "const": "finalized_chain_id_block_number_and_block_hash"
        }
      }
    },
    "independentPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mutable_metadata_host_allowed",
        "append_only_host",
        "metadata_mutation_pause_applies",
        "collection_freeze_applies",
        "record_hash_recorder_scope",
        "latest_pointer_scope"
      ],
      "properties": {
        "mutable_metadata_host_allowed": {
          "const": false
        },
        "append_only_host": {
          "const": "StreamPreservationRecords"
        },
        "metadata_mutation_pause_applies": {
          "const": false
        },
        "collection_freeze_applies": {
          "const": false
        },
        "record_hash_recorder_scope": {
          "const": "caller_or_explicit_nonzero_recorder"
        },
        "latest_pointer_scope": {
          "const": "collection_record_type_subject_recorder"
        }
      }
    }
  }
}
