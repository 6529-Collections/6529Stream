      "userdoc": {
        "kind": "user",
        "methods": {
          "collectionExists(uint256)": {
            "notice": "Returns whether the collection identifier has been allocated."
          },
          "collectionFreezeStatus(uint256)": {
            "notice": "Returns whether collection configuration has been permanently frozen."
          },
          "collectionHasMaxSupply(uint256)": {
            "notice": "Returns whether a finite maximum applies to this collection."
          },
          "collectionMaxSupply(uint256)": {
            "notice": "Returns the configured lifetime mint cap in tokens."
          },
          "collectionMintedEver(uint256)": {
            "notice": "Returns the number of completed mints; burns do not reduce this count."
          },
          "collectionNextSerial(uint256)": {
            "notice": "Returns the next collection-local serial available for allocation."
          },
          "collectionStatus(uint256)": {
            "notice": "Returns the current collection lifecycle/status code."
          },
          "collectionSupplyMode(uint256)": {
            "notice": "Returns the collection supply-mode code fixed at creation."
          },
          "createCollection(uint8,bool,uint256,uint8)": {
            "notice": "Creates a collection through an authorized governance action."
          },
          "freezeCollection(uint256)": {
            "notice": "Permanently freezes collection configuration through terminal governance."
          },
          "setCollectionMaxSupply(uint256,uint256)": {
            "notice": "Applies a governed change to the collection lifetime mint cap."
          },
          "setCollectionStatus(uint256,uint8)": {
            "notice": "Applies the governed lifecycle transition for a collection."
          },
          "totalSupplyOfCollection(uint256)": {
            "notice": "Returns the collection live token count, excluding burned tokens."
          }
        },
        "notice": "Governed creation and lifecycle changes for permanent collections.",
        "version": 1
      }
