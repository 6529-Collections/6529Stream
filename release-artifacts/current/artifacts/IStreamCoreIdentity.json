            "notice": "Returns the permanent collection mapping, serial, and burn flag for a token."
          },
          "tokenLifecycle(uint256)": {
            "notice": "Returns UNKNOWN=0, PREPARED_INCOMPLETE=1, MINTED=2, or BURNED=3."
