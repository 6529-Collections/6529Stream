      "devdoc": {
        "kind": "dev",
        "methods": {
          "abortPreparedMintFromManager(uint256,bytes32)": {
            "details": "The installed caller must differ from the preparing manager. The exact      token/operation match is required; abort removes its identity/data and      rewinds the global token and collection serial allocation frontiers."
          },
          "completePreparedMintFromManager(uint256,address,bytes32,bytes32)": {
            "details": "The caller, tokenId, and operationId must match the pending preparation.",
            "params": {
              "initialRecipient": "Address receiving the completed token and safe-receiver callback.",
              "mintCommitment": "Per-token commitment supplied at completion."
            }
          },
          "mintFromManager(uint256,address,bytes,bytes32,bytes32)": {
            "details": "Only the installed manager may call; receiver rejection rolls back the entire mint.",
            "params": {
              "collectionId": "Existing collection receiving the new token.",
              "initialRecipient": "Address receiving the ERC-721 token and its safe-receiver callback.",
              "mintCommitment": "Per-token commitment passed to the entropy registration boundary.",
              "tokenDataHash": "keccak256 of tokenData_.",
              "tokenData_": "Artwork bytes whose exact encoding is committed by tokenDataHash."
            },
            "returns": {
              "collectionSerial": "Collection-local serial assigned to this token.",
              "tokenId": "Globally allocated token identifier."
            }
          },
          "prepareMintFromManager(uint256,bytes,bytes32,bytes32)": {
            "details": "Only the installed manager may call; at most one prepared token exists at a time.",
            "params": {
              "operationId": "Nonzero identity repeated at completion or by a replacement manager during abort."
            }
          }
        },
        "version": 1
      },
      "userdoc": {
        "kind": "user",
        "methods": {
          "abortPreparedMintFromManager(uint256,bytes32)": {
            "notice": "Aborts a pending preparation through the installed replacement manager."
          },
          "completePreparedMintFromManager(uint256,address,bytes32,bytes32)": {
            "notice": "Completes the manager operation that owns the prepared token."
          },
          "mintFromManager(uint256,address,bytes,bytes32,bytes32)": {
            "notice": "Allocates and safely mints a token for the installed mint manager."
          },
          "pendingPreparedMintTokenId()": {
            "notice": "Returns the singleton pending token identifier, or zero when none exists."
          },
          "prepareMintFromManager(uint256,bytes,bytes32,bytes32)": {
            "notice": "Reserves the singleton prepared token without completing its ERC-721 mint."
          },
          "preparedMint(uint256)": {
            "notice": "Returns the public pending-operation record for a token."
          },
          "tokenData(uint256)": {
            "notice": "Returns the token artwork data stored by the mint operation."
          }
        },
        "notice": "Manager-only token allocation, prepared mint lifecycle, and token data.",
        "version": 1
      }
    },
