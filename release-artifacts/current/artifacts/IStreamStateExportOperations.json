      "devdoc": {
        "details": "Every write is rejected during a governance batch or after publisher replacement.",
        "kind": "dev",
        "methods": {
          "challengeStateExport(bytes32,bytes32,string)": {
            "details": "Challenges do not alter the latest export or supersession lineage."
          },
          "publishStateExport(uint256,bytes32,bytes32,bytes32,string)": {
            "details": "The past block must be within the EVM's 256-block hash window. Heights      increase; equal height is allowed only for a different canonical reorg hash.      All hashes are nonzero. URI is nonempty strict UTF-8, at most 2,048 bytes."
          },
          "supersedeStateExport(bytes32,bytes32,bytes32,string)": {
            "details": "Both claims must exist on this publisher. Forward-only sequence links      prevent cycles. The latest publication and all historical data are retained."
          }
        },
        "version": 1
      },
      "userdoc": {
        "kind": "user",
        "methods": {
          "challengeStateExport(bytes32,bytes32,string)": {
            "notice": "Anyone may append one challenge per (known export, nonzero challenge hash)."
          },
          "publishStateExport(uint256,bytes32,bytes32,bytes32,string)": {
            "notice": "A live ROLE_EXPORT_PUBLISHER holder appends a unique canonical recent-block claim."
          },
          "supersedeStateExport(bytes32,bytes32,bytes32,string)": {
            "notice": "A live publisher links an older claim once to a previously published newer claim."
          }
        },
        "notice": "Append-only state-export operations on the active governance-hosted publisher.",
        "version": 1
      }
