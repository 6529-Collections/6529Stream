      "devdoc": {
        "details": "Caller ABI at the manager address. Use IStreamMintManager for ERC165      discovery and canonical nested request types; subset IDs are not advertised.",
        "kind": "dev",
        "methods": {
          "executePreparedMint((uint256,bytes32,address,address,address[],address[],bytes[],bytes32[],bytes32,bytes32,bytes32,bytes),bytes)": {
            "details": "Uses the same phase authorization and atomicity rules as executeSingleStepMint.",
            "params": {
              "batch": "Canonical manager request and expected phase-policy commitment.",
              "gateData": "Opaque verification bytes interpreted by the configured phase gate."
            },
            "returns": {
              "operationIds": "Ordered per-token operation identities.",
              "operationRoot": "Commitment binding the complete normalized mint operation.",
              "tokenIds": "Globally allocated Core token identifiers in request order."
            }
          },
          "executeSingleStepMint((uint256,bytes32,address,address,address[],address[],bytes[],bytes32[],bytes32,bytes32,bytes32,bytes),bytes)": {
            "details": "The caller must be an authorized executor for the phase. Any downstream failure      reverts all token allocation, ledger consumption, and replay-state changes.",
            "params": {
              "batch": "Canonical manager request; parallel token arrays must have matching lengths.",
              "gateData": "Opaque verification bytes interpreted by the configured phase gate."
            },
            "returns": {
              "operationIds": "Ordered per-token operation identities.",
              "operationRoot": "Commitment binding the complete normalized mint operation.",
              "tokenIds": "Globally allocated Core token identifiers in request order."
            }
          }
        },
        "version": 1
      },
      "userdoc": {
        "kind": "user",
        "methods": {
          "executePreparedMint((uint256,bytes32,address,address,address[],address[],bytes[],bytes32[],bytes32,bytes32,bytes32,bytes),bytes)": {
            "notice": "Executes the prepared Core manager path atomically."
          },
          "executeSingleStepMint((uint256,bytes32,address,address,address[],address[],bytes[],bytes32[],bytes32,bytes32,bytes32,bytes),bytes)": {
            "notice": "Executes the immediate Core manager path atomically."
          }
        },
        "notice": "Atomic immediate and prepared token mint execution through the manager.",
        "version": 1
      }
