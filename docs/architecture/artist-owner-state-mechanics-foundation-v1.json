  "selected_foundation": {
    "option_id": "lean_typed_mapping_transition_accumulator_v1",
    "selection_posture": "outer_mechanics_only_no_decision_acceptance",
    "rationale": [
      "typed isolated storage preserves exactly one authoritative owner per semantic domain",
      "immutable deployment-chain, Registry, Coordinator, ArchiveV2 and domain identity prevents cross-suite or cross-chain rekeying",
      "a fixed header, roots and replay mapping bound constant work without exposing generic mutation",
      "history-sensitive owner-recomputed accumulators make rollback, opaque-input and no-op drift observable while ArchiveV2 remains evidence-only"
    ],
    "rejected_options": [
      {
        "option_id": "generic_hash_only_envelopes",
        "disposition": "rejected",
        "reason": "does not freeze typed storage ownership or replay capabilities and can conceal incompatible domain state"
      },
      {
        "option_id": "sparse_merkle_tree_for_all_state",
        "disposition": "rejected",
        "reason": "adds proof, gas and denial-of-service complexity without an accepted proof-consumer requirement"
      },
      {
        "option_id": "full_append_only_owner_log",
        "disposition": "rejected",
        "reason": "unbounded owner-local history and enumeration duplicate ArchiveV2 evidence responsibilities"
      },
      {
        "option_id": "premature_full_hybrid_acceptance",
        "disposition": "rejected",
        "reason": "would invent unresolved domain structs, replay scopes, lifecycle assignments, commitments and construction preimages"
      }
    ]
  },
