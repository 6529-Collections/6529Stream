  "selected_shape": {
    "option_id": "dual_semantic_hash_and_owner_v2_commitment",
    "selection_posture": "record_inner_prerequisite_only",
    "rationale": [
      "the exact retained semantic hash preserves the 37-family compatibility identity",
      "the owner V2 commitment binds immutable suite and owner identity plus successful owner revision, record sequence and original caller",
      "the fixed zero-one-two record delta closes bounded record history without selecting an entrypoint ABI",
      "the later action commitment remains responsible for recipe, action and exact typed calldata identity"
    ],
    "rejected_options": [
      {
        "option_id": "legacy_semantic_hash_only",
        "reason": "does not bind isolated V2 owner identity, revision, sequence or history"
      },
      {
        "option_id": "replace_legacy_hash_with_owner_v2_hash",
        "reason": "breaks retained record identity and historical reconstruction compatibility"
      },
      {
        "option_id": "opaque_or_generic_record_word",
        "reason": "allows Coordinator supplied identity and conceals typed record-domain and semantic-hash boundaries"
      },
      {
        "option_id": "wait_for_entrypoint_abi",
        "reason": "unnecessary because record identity is fully determined by exact record components, owner identity, original caller and owner history; action identity remains separately blocked"
      }
    ]
