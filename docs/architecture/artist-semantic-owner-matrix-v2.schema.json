            "snapshot_id": {
              "const": "domain:payout_lifecycle"
            },
            "must_precede": {
              "const": "domain:consent_finality"
            }
          }
        },
        "rollback_policy": {
          "type": "string",
          "minLength": 1
        },
        "export_policy": {
          "type": "string",
          "minLength": 1
