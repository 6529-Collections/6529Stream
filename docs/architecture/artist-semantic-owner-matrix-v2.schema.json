            },
            "owner_count": {
              "const": 1
            }
          }
        },
        "artist_erc1271": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ggp_key",
            "owner_domain",
            "owner",
            "owner_count",
            "scope",
