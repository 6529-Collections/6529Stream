      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_family_authority_provider",
        "artist_erc1271"
      ],
      "properties": {
        "record_family_authority_provider": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "interface",
